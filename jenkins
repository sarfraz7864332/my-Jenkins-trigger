pipeline {
    agent any
    stages {
        stage('Testing Jenkins') {
            steps {
                script {
                    def ip = sh(script: 'hostname -I | cut -d " " -f 2', returnStdout: true).trim()
                    echo "Hostname:"
                    sh 'hostname'
                    echo "Memory Usage:"
                    sh 'free -m'
                    git clone https://github.com/sarfraz7864332/my-Jenkins-trigger.git
                    cd my-Jenkins-trigger && ./websetup.sh
                    echo "webpage deployed"
                    echo "Jenkins server address: http://${ip}:8080/"
                }
            }
        }
    }
}
